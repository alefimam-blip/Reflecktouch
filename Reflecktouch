<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Refleck Touch</title>
<style>
:root{--ink:#15123d;--sf:#221c5e;--sf2:#2d2578;--ln:#4a3fb0;--tx:#f6f3ff;--mu:#a9a3e0;--y:#ffd23f;--m:#3ee6b0;--r:#ff5d6c}
*{box-sizing:border-box;margin:0;padding:0}
body{min-height:100vh;font-family:ui-rounded,"SF Pro Rounded","Arial Rounded MT Bold","Segoe UI",system-ui,sans-serif;color:var(--tx);background:radial-gradient(#ffffff14 1.5px,transparent 1.6px) 0 0/26px 26px,var(--ink);-webkit-tap-highlight-color:transparent}
button,input{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--m);outline-offset:2px}
.hide{display:none!important}
.mut{color:var(--mu);font-size:.88rem}
.card{background:var(--sf);border:2px solid var(--ln);border-radius:20px;padding:22px;box-shadow:0 6px 0 #0d0a2b}
.btn{border:0;cursor:pointer;padding:12px 24px;border-radius:999px;font-weight:800;background:var(--y);color:#2a1f00;box-shadow:0 4px 0 #b88a00;transition:transform .1s,box-shadow .1s}
.btn:active{transform:translateY(3px);box-shadow:0 1px 0 #b88a00}
.btn.s{background:var(--sf2);color:var(--tx);border:2px solid var(--ln);padding:8px 16px;box-shadow:0 3px 0 #0d0a2b}
.btn.s:active{box-shadow:0 0 0 #0d0a2b}
.inp{width:100%;padding:13px 15px;border-radius:12px;border:2px solid var(--ln);background:#100d33;outline:0}
.inp:focus{border-color:var(--y)}
label{display:block;font-size:.85rem;color:var(--mu);margin:14px 0 6px}
h1,h3{color:var(--y);text-shadow:2px 2px 0 #0d0a2b}
h1{font-size:2rem;text-align:center}
#login{min-height:100vh;display:grid;place-items:center;padding:20px}
#lc{width:min(400px,100%)}
.logo{width:72px;height:72px;border-radius:50%;margin:0 auto 12px;background:radial-gradient(circle closest-side,var(--y) 0 20%,var(--ink) 20% 32%,var(--r) 32% 50%,var(--ink) 50% 62%,var(--m) 62%);animation:pl 2.4s ease-in-out infinite}
@keyframes pl{50%{transform:scale(1.07) rotate(8deg)}}
#err{color:var(--r);font-size:.88rem;min-height:1.3em;margin:12px 0 4px;text-align:center}
.shake{animation:sk .35s}
@keyframes sk{25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}
.wrap{max-width:860px;margin:0 auto;padding:16px 16px 48px}
header{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:16px}
header b{font-size:1.4rem;color:var(--y);text-shadow:2px 2px 0 #0d0a2b}
.usr{display:flex;align-items:center;gap:10px}
.av{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;font-weight:900;background:var(--m);color:#06382a;flex:none}
nav{display:flex;gap:6px;padding:5px;border-radius:999px;background:var(--sf);border:2px solid var(--ln);margin-bottom:16px;width:fit-content;max-width:100%;overflow:auto}
nav button{border:0;background:0;padding:9px 18px;border-radius:999px;cursor:pointer;color:var(--mu);font-weight:700;white-space:nowrap}
nav button.on{background:var(--y);color:#2a1f00}
.hud{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:10px}
.st{text-align:center;padding:8px;border-radius:14px;background:var(--sf);border:2px solid var(--ln)}
.st small{display:block;color:var(--mu);font-size:.78rem}
.st b{font-size:1.7rem;font-variant-numeric:tabular-nums}
#sc{color:var(--y)}
.pb{height:8px;border-radius:9px;background:#100d33;overflow:hidden;margin-bottom:10px}
#bar{height:100%;width:100%;background:var(--y)}
#arena{position:relative;height:clamp(340px,56vh,540px);border-radius:22px;overflow:hidden;border:2px solid var(--ln);touch-action:manipulation;user-select:none;-webkit-user-select:none;background:linear-gradient(#ffffff0d 1px,transparent 1px) 0 0/44px 44px,linear-gradient(90deg,#ffffff0d 1px,transparent 1px) 0 0/44px 44px,var(--sf)}
#arena.bad{animation:bd .3s}
@keyframes bd{50%{box-shadow:inset 0 0 70px #ff5d6c99}}
.tg{position:absolute;border:0;border-radius:50%;cursor:pointer;background:radial-gradient(circle closest-side,#fff 0 16%,var(--r) 16% 46%,var(--y) 46%);box-shadow:0 4px 0 #a37a00;animation:pop .15s}
.tg::after{content:"";position:absolute;inset:-7px;border:3px solid var(--m);border-radius:50%;pointer-events:none;animation:rg var(--life) linear forwards}
@keyframes pop{from{transform:scale(0)}}
@keyframes rg{from{transform:scale(2);opacity:1}to{transform:scale(1);opacity:.3}}
.fl{position:absolute;font-weight:900;font-size:1.2rem;color:var(--y);pointer-events:none;text-shadow:2px 2px 0 #0d0a2b;animation:fl .7s forwards}
@keyframes fl{to{transform:translateY(-46px);opacity:0}}
.fl.neg{color:var(--r)}
.tg.bomb{background:radial-gradient(circle closest-side,#2a2140 0 62%,var(--r) 62%);box-shadow:0 4px 0 #8f1f2b;padding:0;line-height:1}
.tg.bomb::after{border-color:var(--r)}
#ov{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;text-align:center;padding:20px;background:#15123de6}
#ov h2{font-size:1.7rem;color:var(--y);text-shadow:2px 2px 0 #0d0a2b}
#ov p{color:var(--mu);max-width:340px;line-height:1.55}
#ov p b{color:var(--tx);font-size:1.5rem}
.row{display:grid;grid-template-columns:46px 1fr auto auto;gap:12px;align-items:center;padding:12px 14px;border-radius:14px;background:var(--sf2);border:2px solid var(--ln);margin-top:10px}
.row.r1{border-color:var(--y);background:#ffd23f26}
.row.r2{border-color:#d9dcff}
.row.r3{border-color:#ff9f5c}
.row.me{box-shadow:0 0 0 3px var(--m)}
.rk{font-size:1.5rem;text-align:center;font-weight:900;color:var(--mu)}
.rt{font-size:.8rem;color:var(--mu);text-align:right}
.sc{font-weight:900;font-size:1.3rem;min-width:56px;text-align:right;color:var(--y)}
.fr{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}
.fr .inp{flex:1;min-width:160px}
.cd{display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:14px;background:#100d33;border:2px solid var(--ln);margin-top:10px;flex-wrap:wrap}
.cd span{flex:1;min-width:100px;font-weight:700}
.cd code{font:800 1rem ui-monospace,Menlo,Consolas,monospace;letter-spacing:.14em;color:var(--m);background:#3ee6b01a;padding:6px 10px;border-radius:8px}
#toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,16px);padding:11px 20px;border-radius:999px;background:var(--m);color:#06382a;font-weight:800;opacity:0;transition:.25s;pointer-events:none;z-index:9}
#toast.on{opacity:1;transform:translate(-50%,0)}
@media(prefers-reduced-motion:reduce){*{animation-duration:.01ms!important}}
</style>
</head>
<body>

<section id="login">
  <div class="card" id="lc">
    <div class="logo"></div>
    <h1>Refleck Touch</h1>
    <p class="mut" style="text-align:center;margin-top:6px">Masukkan username dan kode dari admin untuk mulai bermain.</p>
    <label for="u">Username</label>
    <input class="inp" id="u" autocomplete="username" placeholder="contoh: budi">
    <label for="c">Kode</label>
    <input class="inp" id="c" type="password" autocomplete="off" placeholder="XXXX-XXXX">
    <div id="err"></div>
    <button class="btn" id="go" style="width:100%">Masuk</button>
    <p class="mut" style="text-align:center;margin-top:14px">Belum punya kode? Minta ke admin.</p>
  </div>
</section>

<div id="app" class="wrap hide">
  <header>
    <b>Refleck Touch</b>
    <div class="usr"><div class="av" id="av"></div><span id="nm"></span><button class="btn s" id="out">Keluar</button></div>
  </header>
  <nav id="nav">
    <button data-v="play" class="on">🎯 Main</button>
    <button data-v="board">🏆 Leaderboard</button>
    <button data-v="admin" class="hide" id="tabA">🔑 Admin</button>
  </nav>

  <section id="v-play">
    <div class="hud">
      <div class="st"><small>Waktu</small><b id="tm">30.0</b></div>
      <div class="st"><small>Skor</small><b id="sc">0</b></div>
      <div class="st"><small>Kombo</small><b id="cb">x0</b></div>
    </div>
    <div class="pb"><div id="bar"></div></div>
    <div id="arena">
      <div id="ov">
        <h2 id="ot">Siap uji refleks?</h2>
        <p id="op">Ketuk target sebelum cincin hijau menutup. Hindari bom 💣. Salah ketuk atau target yang terlewat akan mengurangi poin.</p>
        <button class="btn" id="bs">Mulai</button>
        <button class="btn s hide" id="tolb">Lihat leaderboard</button>
      </div>
    </div>
  </section>

  <section id="v-board" class="hide">
    <div class="card">
      <h3>🏆 Leaderboard</h3>
      <p class="mut">Diurutkan dari skor terbaik.</p>
      <div id="lb"></div>
    </div>
  </section>

  <section id="v-admin" class="hide">
    <div class="card">
      <h3>🔑 Panel admin</h3>
      <p class="mut">Buat kode masuk untuk pemain. Satu username hanya punya satu kode; membuat ulang akan mengganti kode lama.</p>
      <div class="fr">
        <input class="inp" id="nu" placeholder="Username pemain">
        <button class="btn" id="mk">Buat kode</button>
      </div>
      <div id="cl"></div>
      <button class="btn s" id="rs" style="margin-top:18px">Reset leaderboard</button>
    </div>
  </section>
</div>
<div id="toast"></div>

<script>
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
// Ganti login admin di sini
const ADMIN={u:'admin',c:'ADMIN-2026'};
const K={codes:'rt_codes',scores:'rt_scores',ses:'rt_ses'},mem={};
const db={
  get(k,d){try{const v=JSON.parse(localStorage.getItem(k));return v??d}catch(e){return mem[k]??d}},
  set(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){mem[k]=v}}
};
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let me=null,G=null;

function toast(t){const e=$('#toast');e.textContent=t;e.classList.add('on');clearTimeout(toast.t);toast.t=setTimeout(()=>e.classList.remove('on'),2000)}

/* ---------- Login ---------- */
function fail(m){$('#err').textContent=m;const c=$('#lc');c.classList.remove('shake');void c.offsetWidth;c.classList.add('shake')}
function login(){
  const u=$('#u').value.trim(),c=$('#c').value.trim().toUpperCase();
  if(!u||!c)return fail('Isi username dan kode dulu.');
  if(u.toLowerCase()===ADMIN.u&&c===ADMIN.c)return enter({u:ADMIN.u,admin:1});
  const ok=db.get(K.codes,[]).find(x=>x.u.toLowerCase()===u.toLowerCase()&&x.c===c);
  if(!ok)return fail('Username atau kode salah. Cek lagi, atau minta kode baru ke admin.');
  enter({u:ok.u});
}
function enter(s){
  me=s;db.set(K.ses,s);
  $('#login').classList.add('hide');$('#app').classList.remove('hide');
  $('#nm').textContent=s.u;$('#av').textContent=s.u[0].toUpperCase();
  $('#tabA').classList.toggle('hide',!s.admin);
  show('play');
}
$('#go').onclick=login;
['u','c'].forEach(i=>$('#'+i).addEventListener('keydown',e=>{if(e.key==='Enter')login()}));
$('#out').onclick=()=>{stopGame();db.set(K.ses,null);me=null;$('#app').classList.add('hide');$('#login').classList.remove('hide');$('#c').value='';$('#err').textContent=''};

/* ---------- Navigasi ---------- */
function show(v){
  if(v!=='play')stopGame();
  $$('#nav button').forEach(b=>b.classList.toggle('on',b.dataset.v===v));
  ['play','board','admin'].forEach(x=>$('#v-'+x).classList.toggle('hide',x!==v));
  if(v==='board')board();
  if(v==='admin')codes();
  if(v==='play'&&!G)resetOv();
}
$$('#nav button').forEach(b=>b.onclick=()=>show(b.dataset.v));

/* ---------- Admin ---------- */
function gen(){
  const a='ABCDEFGHJKLMNPQRSTUVWXYZ23456789',r=crypto.getRandomValues(new Uint8Array(8));
  return[...r].map(n=>a[n%a.length]).join('').replace(/(.{4})/,'$1-');
}
$('#mk').onclick=()=>{
  const u=$('#nu').value.trim();
  if(!u)return toast('Isi username pemain dulu');
  if(u.toLowerCase()===ADMIN.u)return toast('Username itu dipakai admin');
  const l=db.get(K.codes,[]).filter(x=>x.u.toLowerCase()!==u.toLowerCase());
  l.unshift({u,c:gen()});db.set(K.codes,l);
  $('#nu').value='';codes();toast('Kode dibuat untuk '+u);
};
$('#nu').addEventListener('keydown',e=>{if(e.key==='Enter')$('#mk').click()});
function codes(){
  const l=db.get(K.codes,[]);
  $('#cl').innerHTML=l.length?l.map((x,i)=>`<div class="cd"><span>${esc(x.u)}</span><code>${x.c}</code><button class="btn s" data-cp="${i}">Salin</button><button class="btn s" data-dl="${i}">Hapus</button></div>`).join(''):'<p class="mut" style="margin-top:14px">Belum ada kode. Buat kode pertama di atas.</p>';
}
$('#cl').onclick=e=>{
  const b=e.target.closest('button');if(!b)return;
  const l=db.get(K.codes,[]);
  if(b.dataset.cp!==undefined){
    const t=l[b.dataset.cp].c;
    (navigator.clipboard?navigator.clipboard.writeText(t):Promise.reject()).then(()=>toast('Kode disalin'),()=>toast('Kode: '+t));
  }else if(b.dataset.dl!==undefined){
    l.splice(b.dataset.dl,1);db.set(K.codes,l);codes();toast('Kode dihapus');
  }
};
$('#rs').onclick=()=>{if(confirm('Hapus semua skor di leaderboard?')){db.set(K.scores,{});toast('Leaderboard direset')}};

/* ---------- Leaderboard ---------- */
function board(){
  const a=Object.values(db.get(K.scores,{})).sort((x,y)=>y.best-x.best||x.rt-y.rt),m=['🥇','🥈','🥉'];
  $('#lb').innerHTML=a.length?a.map((p,i)=>`<div class="row r${i<3?i+1:0}${me&&p.n.toLowerCase()===me.u.toLowerCase()?' me':''}"><div class="rk">${m[i]||i+1}</div><div><b>${esc(p.n)}</b><div class="mut">${p.plays}x main</div></div><div class="rt">${p.rt} ms<br>rata-rata</div><div class="sc">${p.best}</div></div>`).join(''):'<p class="mut" style="margin-top:16px">Belum ada skor. Mainkan satu ronde untuk jadi yang pertama.</p>';
}

/* ---------- Game ---------- */
function hud(t,s,c){$('#tm').textContent=t.toFixed(1);$('#sc').textContent=s;$('#cb').textContent='x'+c;$('#bar').style.width=t/30*100+'%'}
function resetOv(){
  $('#ot').textContent='Siap uji refleks?';
  $('#op').textContent='Ketuk target sebelum cincin hijau menutup. Hindari bom 💣. Salah ketuk atau target yang terlewat akan mengurangi poin.';
  $('#bs').textContent='Mulai';$('#tolb').classList.add('hide');$('#ov').classList.remove('hide');hud(30,0,0);
}
function stopGame(){
  if(!G)return;
  G.on=0;cancelAnimationFrame(G.raf);clearTimeout(G.to);clearTimeout(G.kill);
  $$('.tg,.fl').forEach(e=>e.remove());G=null;
}
function start(){
  stopGame();
  G={t0:performance.now(),s:0,h:0,m:0,w:0,b:0,n:0,lb:0,cb:0,rts:[],on:1};
  $('#ov').classList.add('hide');hud(30,0,0);tick();spawn(400);
}
function tick(){
  if(!G)return;
  const l=30000-(performance.now()-G.t0);
  if(l<=0)return end();
  hud(l/1000,G.s,G.cb);G.raf=requestAnimationFrame(tick);
}
function spawn(d){
  G.to=setTimeout(()=>{
    if(!G)return;
    const ar=$('#arena'),z=Math.max(48,80-G.h)|0,life=Math.max(600,1300-G.h*20),t=performance.now(),el=document.createElement('button');
    const bomb=++G.n>3&&!G.lb&&Math.random()<.28;G.lb=bomb;el.className='tg'+(bomb?' bomb':'');if(bomb)el.textContent='💣';
    el.style.cssText=`width:${z}px;height:${z}px;left:${12+Math.random()*(ar.clientWidth-z-24)}px;top:${12+Math.random()*(ar.clientHeight-z-24)}px;--life:${life}ms;font-size:${z*.55}px`;
    el.onpointerdown=e=>{
      e.stopPropagation();
      if(!G||G.el!==el)return;
      G.el=null;clearTimeout(G.kill);
      if(bomb){G.s=Math.max(0,G.s-100);G.b++;G.cb=0;pop(e,'-100 💥',1);flash();navigator.vibrate&&navigator.vibrate(90);el.remove();spawn(250);return}
      const rt=performance.now()-t,p=Math.round(100+100*(1-rt/life))+Math.min(G.cb,10)*10;
      G.cb++;G.h++;G.s+=p;G.rts.push(rt);
      pop(e,'+'+p);el.remove();spawn(120+Math.random()*250);
    };
    G.el=el;ar.appendChild(el);
    G.kill=setTimeout(()=>{
      if(!G||G.el!==el)return;
      G.el=null;el.remove();
      if(!bomb){G.m++;G.cb=0;G.s=Math.max(0,G.s-50);const r=ar.getBoundingClientRect();pop({clientX:r.left+parseFloat(el.style.left)+z/2-8,clientY:r.top+parseFloat(el.style.top)},'-50',1);flash()}
      spawn(200);
    },life);
  },d);
}
function pop(e,t,n){
  const ar=$('#arena'),r=ar.getBoundingClientRect(),f=document.createElement('div');
  f.className='fl'+(n?' neg':'');f.textContent=t;f.style.left=(e.clientX-r.left-16)+'px';f.style.top=(e.clientY-r.top-24)+'px';
  ar.appendChild(f);setTimeout(()=>f.remove(),700);
}
function flash(){const a=$('#arena');a.classList.remove('bad');void a.offsetWidth;a.classList.add('bad')}
$('#arena').onpointerdown=e=>{if(G&&G.on){G.cb=0;G.w++;G.s=Math.max(0,G.s-25);pop(e,'-25',1);flash()}};
function save(s,rt){
  const a=db.get(K.scores,{}),k=me.u.toLowerCase(),o=a[k]||{n:me.u,best:0,rt:0,plays:0};
  o.plays++;const nb=s>o.best;
  if(nb){o.best=s;o.rt=rt}
  a[k]=o;db.set(K.scores,a);return nb;
}
function end(){
  const s=G.s,h=G.h,m=G.m,w=G.w,b=G.b,rt=h?Math.round(G.rts.reduce((a,b)=>a+b,0)/h):0;
  stopGame();hud(0,s,0);
  const nb=save(s,rt);
  $('#ot').textContent=nb?'🎉 Rekor baru!':'Waktu habis!';
  $('#op').innerHTML=`Skor <b>${s}</b><br>${h} kena · ${m} terlewat · ${w} salah ketuk<br>${b} kena bom · rata-rata ${rt} ms`;
  $('#bs').textContent='Main lagi';$('#tolb').classList.remove('hide');$('#ov').classList.remove('hide');
}
$('#bs').onclick=start;
$('#tolb').onclick=()=>show('board');

/* ---------- Mulai ---------- */
const s0=db.get(K.ses,null);
if(s0&&(s0.admin||db.get(K.codes,[]).some(x=>x.u.toLowerCase()===s0.u.toLowerCase())))enter(s0);
</script>
</body>
</html>
